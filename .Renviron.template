# --- FileMaker API --------------------------------------------

HBDB_API_USR=api
HBDB_API_PWD=your_api_password_here
FM_BASE_URL=https://your-filemaker-server.example.com

# --- PostgreSQL ------------------------------------------------

PGDATABASE=herbarium
PGUSER=herbarium
PGPASSWORD=your_pg_password_here
PGHOST=localhost
PGPORT=5432  # or 5433 to avoid port conflicts

# --- IPT (per target; run_pipeline.R picks TEST or PROD) ------

IPT_TEST_BASE_URL=https://test.gbif.se/ipt
IPT_TEST_RESOURCE=gb_herbarium
IPT_TEST_USER=your_test_user_email
IPT_TEST_PASS=your_test_ipt_password

IPT_PROD_BASE_URL=https://www.gbif.se/ipt
IPT_PROD_RESOURCE=gb_herbarium
IPT_PROD_USER=your_prod_user_email
IPT_PROD_PASS=your_prod_ipt_password